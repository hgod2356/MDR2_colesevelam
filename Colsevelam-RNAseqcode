topT.res01 <- as.data.frame(res01genename)

# Volcano plot
with(topT.res01, plot(log2FoldChange, -log10(padj), pch=20, main="Volcano plot", col='grey', 
                      cex=1.0, xlab=bquote(~Log[2]~fold~change), ylab=bquote(~-log[10]~Q~value)))

with(subset(topT.res01, padj<cut_pvalue & log2FoldChange>cut_lfc), 
     points(log2FoldChange, -log10(padj), pch=20, col='#228833', cex=1.5))

with(subset(topT.res01, padj<cut_pvalue & log2FoldChange<(-cut_lfc)), 
     points(log2FoldChange, -log10(padj), pch=20, col='#E7AC02', cex=1.5))

# Add threshold lines
abline(v=0, col='black', lty=3, lwd=1.0)
abline(v=-cut_lfc, col='black', lty=4, lwd=2.0)
abline(v=cut_lfc, col='black', lty=4, lwd=2.0)
abline(h=-log10(max(topT.res01$padj[topT.res01$padj<cut_pvalue], na.rm=TRUE)), col='black', lty=4, lwd=2.0)

# Highlight specific genes
genes_to_label <- c("Lcn2", "Lbp", "Nfkb1", "Tnfa", "Col1a1", "Tgfa")
label_data <- subset(topT.res01, gene %in% genes_to_label)

# Annotate genes with arrows and labels
for (i in 1:nrow(label_data)) {
  gene_x <- label_data$log2FoldChange[i]
  gene_y <- -log10(label_data$padj[i])
  
  # Adjust label positions dynamically
  if (gene_x > 0) {
    text_x <- gene_x + 2.5  # Shift label to the right
    text_y <- gene_y + 2.5    # Shift label slightly upward
  } else {
    text_x <- gene_x - 0.5  # Shift label to the left
    text_y <- gene_y + 2    # Shift label slightly upward
  }
  
  # Add arrow
  arrows(gene_x, gene_y, text_x, text_y - 1, col="black", length=0.1, lwd=1.5)
  
  # Add label
  text(text_x, text_y, labels=label_data$gene[i], cex=1.0, col="black")
}


