#Blastx - Align translated DNA query sequences against a protein reference database
qseqid sseqid stitle pident slen length mismatch gapopen qstart qend sstart send evalue bitscore staxids sscinames sphylums full_qseq full_sseq

diamond blastx -d refseq_viral/viral_protein_diamonddb_full.dmnd -q 4-1.checkv_using3-1,length3000/KO_col5/combined.fna --threads 100 -o 7.blastx_diamond,length3000/KO_col5/diamond_match_sensitive.tsv -e 1e-5 --sensitive -f 6 qseqid sseqid stitle pident slen length mismatch gapopen qstart qend sstart send evalue bitscore staxids sscinames sphylums full_qseq full_sseq
